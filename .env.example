# Optionnel — laisse commenté pour le mode démo (comptes en localStorage).
#
# WooCommerce REST (création clients + produits)
# VITE_WC_URL=https://ton-site.local
# VITE_WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Connexion réelle : plugin "JWT Authentication for WP-API"
# VITE_WC_JWT_ENDPOINT=https://ton-site.local/wp-json/jwt-auth/v1/token
#
# CORS : autoriser l'origine du front dans WordPress (ou un proxy Vite).
