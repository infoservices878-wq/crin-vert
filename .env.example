# Optionnel — laisse commenté pour le mode démo (comptes en localStorage).
#
# Le serveur boutique.equinutrition.fr est le seul à parler à WooCommerce.
# Ne placez aucune clé WooCommerce, paiement ou JWT dans le frontend.
#
# CORS : autoriser l'origine du front dans WordPress (ou un proxy Vite).
# Public storefront API. Never put WooCommerce consumer keys or payment secrets in VITE_ variables.
VITE_API_URL=https://boutique.equinutrition.fr/wp-json/equinutrition
